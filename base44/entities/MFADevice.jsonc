{
  "name": "MFADevice",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email de l'utilisateur"
    },
    "device_type": {
      "type": "string",
      "enum": [
        "TOTP",
        "ITSME",
        "BACKUP_CODES"
      ],
      "description": "Type de dispositif MFA"
    },
    "device_name": {
      "type": "string",
      "description": "Nom du dispositif (ex: iPhone, Google Authenticator)"
    },
    "totp_secret_encrypted": {
      "type": "string",
      "description": "Secret TOTP chiffr\u00e9 (base32)"
    },
    "backup_codes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "used": {
            "type": "boolean",
            "default": false
          },
          "used_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Codes de secours \u00e0 usage unique"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "enrolled_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_used_at": {
      "type": "string",
      "format": "date-time"
    },
    "trusted_devices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "device_id": {
            "type": "string"
          },
          "device_fingerprint": {
            "type": "string"
          },
          "trusted_until": {
            "type": "string",
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Appareils de confiance (30 jours)"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "user_agent": {
          "type": "string"
        },
        "ip_address": {
          "type": "string"
        },
        "enrollment_method": {
          "type": "string"
        }
      }
    },
    "totp_secret_iv": {
      "type": "string",
      "description": "Vecteur d'initialisation AES-GCM du secret TOTP (hex)"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "ACTIVE",
        "REVOKED"
      ],
      "default": "PENDING",
      "description": "Etat de l'enrolement : PENDING tant que le premier code n'a pas ete verifie"
    },
    "last_used_counter": {
      "type": "number",
      "description": "Dernier pas de temps TOTP consomme. Empeche le rejeu du meme code."
    },
    "backup_code_hashes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hash": {
            "type": "string",
            "description": "SHA-256 du code de secours"
          },
          "used": {
            "type": "boolean",
            "default": false
          },
          "used_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Codes de secours stockes sous forme de hachage uniquement"
    },
    "failed_attempts": {
      "type": "number",
      "default": 0,
      "description": "Tentatives de verification echouees consecutives"
    },
    "locked_until": {
      "type": "string",
      "format": "date-time",
      "description": "Verrouillage anti-force-brute applique cote serveur"
    }
  },
  "required": [
    "user_email",
    "device_type"
  ],
  "rls": {
    "read": {
      "user_email": "{{user.email}}"
    },
    "write": {
      "user_email": "{{user.email}}"
    }
  }
}