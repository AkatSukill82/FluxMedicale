{
  "name": "AnonymousEpiData",
  "type": "object",
  "properties": {
    "age_bracket": {
      "type": "string",
      "enum": [
        "0-4",
        "5-14",
        "15-24",
        "25-44",
        "45-64",
        "65-74",
        "75+"
      ],
      "description": "Tranche d'age. L'age exact n'est pas conserve : combine au sexe, a la region et a une date precise, il est re-identifiant."
    },
    "sex": {
      "type": "string",
      "enum": [
        "M",
        "F",
        "autre"
      ],
      "description": "Sexe du patient"
    },
    "symptoms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Symptomes issus d'un vocabulaire controle ferme. Aucun texte libre."
    },
    "consultation_week": {
      "type": "string",
      "description": "Semaine ISO de la consultation (ex: 2026-W32). La date exacte n'est pas conservee."
    },
    "region_code": {
      "type": "string",
      "description": "Code region (provincial). Optionnel."
    }
  },
  "required": [
    "age",
    "sex",
    "symptoms",
    "consultation_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "editor"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}