{
  "name": "MemoCode",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Code interne (ex: ADMIN-01, MAT-GANTS)"
    },
    "label": {
      "type": "string",
      "description": "Libell\u00e9 du frais"
    },
    "category": {
      "type": "string",
      "enum": [
        "FRAIS_ADMIN",
        "MATERIEL",
        "SUPPLEMENT",
        "DIVERS"
      ],
      "default": "DIVERS",
      "description": "Cat\u00e9gorie de frais"
    },
    "amount": {
      "type": "number",
      "description": "Montant en centimes"
    },
    "vat_rate": {
      "type": "number",
      "default": 0,
      "description": "Taux TVA en %"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "usage_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "code",
    "label",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "editor"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}